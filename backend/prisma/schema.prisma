generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum StudentStatus {
  ACTIVE
  ON_LEAVE
  COMPLETED
  DISCONTINUED
  CANCELLED
}

enum FacultyStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum AdmissionStatus {
  CONFIRMED
  PROVISIONAL
  CANCELLED
  PENDING
  ACTIVE
  COMPLETED
}

enum EnquirySource {
  WEBSITE
  WHATSAPP
  WALK_IN
  REFERRAL
  SOCIAL_MEDIA
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  FOLLOW_UP
  CONVERTED
  REJECTED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ADMITTED
}

enum FeeStatus {
  PAID
  PENDING
}

enum FeePlan {
  FULL_PAYMENT
  INSTALLMENT
}

enum PaymentMethod {
  UPI
  NET_BANKING
  CARD
  CASH
  CHEQUE
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
}

enum OverdueStatus {
  OVERDUE
  DUE_SOON
  PARTIAL
  PAID
}


enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum GoogleConnectionStatus {
  CONNECTED
  REAUTH_REQUIRED
  DISCONNECTED
  EXPIRED
}

enum MeetRecordingStatus {
  ENABLED
  DISABLED
  NOT_SUPPORTED
  PERMISSION_DENIED
  UNKNOWN
}

enum MeetSpaceStatus {
  ACTIVE
  ENDED
  CANCELLED
}

model Institute {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  email     String?
  phone     String?
  address   String?
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches   Branch[]
  users      User[]
  students   Student[]
  faculty    Faculty[]
  courses    Course[]
  admissions Admission[]
  enquiries  Enquiry[]
  applications Application[]

  batches    Batch[]

  payments    Payment[]
  pendingFees PendingFee[]
  createdAtLogs ActivityLog[]
  notifications Notification[]
  leads       Lead[]
  aiConversations AIConversation[]
  masterRecords MasterRecord[]
  googleConnections GoogleWorkspaceConnection[]
  conversations Conversation[]
}

model Branch {
  id          String   @id @default(cuid())
  instituteId String
  name        String
  code        String
  address     String?
  phone       String?
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  users      User[]
  students   Student[]
  faculty    Faculty[]
  admissions Admission[]
  enquiries  Enquiry[]
  applications Application[]

  batches    Batch[]

  payments    Payment[]
  pendingFees PendingFee[]
  notifications Notification[]
  leads       Lead[]
  masterRecords MasterRecord[]
  conversations Conversation[]


  @@unique([instituteId, code])
  @@index([instituteId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model User {
  id              String     @id @default(cuid())
  instituteId     String
  branchId        String?
  name            String
  email           String?
  phone           String?
  passwordHash    String
  status          UserStatus @default(ACTIVE)
  whatsappEnabled Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  userRoles      UserRole[]
  userPermissions UserPermission[]
  refreshTokens  RefreshToken[]
  student        Student?
  faculty        Faculty?
  assignedEnquiries Enquiry[]
  settings UserSettings?

  activityLogs   ActivityLog[]
  notifications  Notification[]

  createdLeads         Lead[]             @relation("LeadCreatedBy")
  assignedLeads        Lead[]             @relation("LeadAssignedTo")
  assignedLeadRecords  LeadAssignment[]   @relation("LeadAssignmentCounsellor")
  assignmentsGiven     LeadAssignment[]   @relation("LeadAssignmentAssignedBy")
  stageChanges         LeadStageHistory[]
  leadActivities       LeadActivity[]
  followUpsAssigned    LeadFollowUp[]     @relation("FollowUpCounsellor")
  followUpsCreated     LeadFollowUp[]     @relation("FollowUpCreatedBy")
  aiConversations      AIConversation[]
  permissionsGranted   UserPermission[]   @relation("PermissionGrantedBy")
  googleConnection     GoogleWorkspaceConnection?
  organizedMeetSpaces  GoogleMeetSpace[]
  chatMemberships      ConversationMember[]
  sentMessages         Message[]

  @@index([instituteId])
  @@index([branchId])
  @@index([instituteId, branchId])
  @@index([email])
  @@index([phone])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Student {
  id            String        @id @default(cuid())
  userId        String?       @unique
  instituteId   String
  branchId      String
  studentCode   String
  dateOfBirth   DateTime?
  qualification String?
  status        StudentStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  admissions            Admission[]
  batchEnrollments      BatchEnrollment[]
  studentAttendances    StudentAttendance[]
  assignmentSubmissions AssignmentSubmission[]
  feedbacks             Feedback[]
  callLogs              CallLog[]
  notifications         Notification[]
  payments              Payment[]
  pendingFees           PendingFee[]
  convertedFromLeads    Lead[]

  @@unique([instituteId, studentCode])
  @@index([instituteId])
  @@index([branchId])
  @@index([instituteId, branchId])
}

model Faculty {
  id             String        @id @default(cuid())
  userId         String        @unique
  instituteId    String
  branchId       String
  employeeCode   String
  specialization String?
  status         FacultyStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  batches           Batch[]
  classSessions     ClassSession[]
  facultyAttendance FacultyAttendance[]

  @@unique([instituteId, employeeCode])
  @@index([instituteId])
  @@index([branchId])
  @@index([instituteId, branchId])
}

model Course {
  id          String   @id @default(cuid())
  instituteId String
  name        String
  code        String
  description String?
  duration    Int?
  category    String?  @default("Web Development")
  mode        String?  @default("HYBRID")
  level       String?  @default("BEGINNER")
  totalHours  Int?     @default(100)
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  modules    CourseModule[]
  admissions Admission[]
  enquiries  Enquiry[]
  applications Application[]

  batches    Batch[]
  leads      Lead[]

  @@unique([instituteId, code])
  @@index([instituteId])
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  name        String
  code        String?
  description String?
  sequence    Int
  duration    Int?
  topics      Json?
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  batchModules BatchModule[]

  @@unique([courseId, sequence])
  @@index([courseId])
}

model Enquiry {
  id             String        @id @default(cuid())
  instituteId    String
  branchId       String?
  enquiryNo      String?
  name           String
  email          String?
  phone          String
  courseId       String
  source         EnquirySource @default(WEBSITE)
  status         EnquiryStatus @default(NEW)
  counselorNotes String?
  assignedToId   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  institute  Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  assignedTo User?       @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  applications Application[]

  @@index([instituteId])
  @@index([branchId])
  @@index([courseId])
  @@index([assignedToId])
}

model Application {
  id            String            @id @default(cuid())
  instituteId   String
  branchId      String?
  applicationNo String            @unique
  enquiryId     String?
  applicantName String
  email         String?
  phone         String
  courseId      String
  feeStatus     FeeStatus         @default(PENDING)
  status        ApplicationStatus @default(SUBMITTED)
  submittedDate DateTime          @default(now())
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  institute  Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enquiry    Enquiry?    @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  admissions Admission[]

  @@index([instituteId])
  @@index([branchId])
  @@index([courseId])
  @@index([enquiryId])
}

model Admission {
  id            String          @id @default(cuid())
  admissionNo   String?         @unique
  studentId     String?
  applicationId String?
  instituteId   String
  branchId      String
  courseId      String
  batchId       String?
  studentName   String?
  email         String?
  phone         String?
  feePlan       FeePlan         @default(INSTALLMENT)
  status        AdmissionStatus @default(CONFIRMED)
  admissionDate DateTime        @default(now())
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  student     Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  institute   Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batch       Batch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)

  batchEnrollments BatchEnrollment[]
  payments         Payment[]
  pendingFees      PendingFee[]
  convertedFromLeads Lead[]

  @@index([studentId])
  @@index([applicationId])
  @@index([instituteId])
  @@index([branchId])
  @@index([courseId])
  @@index([batchId])
}

model Batch {
  id              String      @id @default(cuid())
  instituteId     String
  branchId        String
  courseId        String
  facultyId       String?
  name            String
  code            String
  startDate       DateTime
  expectedEndDate DateTime?
  schedulePattern String?     @default("MWF")
  timeSlot        String?     @default("10:00 AM - 12:00 PM")
  capacity        Int         @default(35)
  status          BatchStatus @default(UPCOMING)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  faculty   Faculty?  @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  schedules     BatchSchedule[]
  batchModules  BatchModule[]
  enrollments   BatchEnrollment[]
  classSessions ClassSession[]
  admissions    Admission[]


  @@unique([instituteId, code])
  @@index([instituteId])
  @@index([branchId])
  @@index([instituteId, branchId])
  @@index([courseId])
  @@index([facultyId])
}

model BatchSchedule {
  id            String    @id @default(cuid())
  batchId       String
  dayOfWeek     Int
  startTime     String
  endTime       String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

model BatchModule {
  id             String    @id @default(cuid())
  batchId        String
  courseModuleId String
  sequence       Int
  startDate      DateTime?
  endDate        DateTime?
  status         Status    @default(ACTIVE)
  createdAt      DateTime  @default(now())

  batch        Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  courseModule CourseModule @relation(fields: [courseModuleId], references: [id], onDelete: Restrict)

  classSessions ClassSession[]

  @@unique([batchId, sequence])
  @@index([batchId])
  @@index([courseModuleId])
}

model BatchEnrollment {
  id          String    @id @default(cuid())
  batchId     String
  studentId   String
  admissionId String?
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now())

  batch     Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  admission Admission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)

  @@unique([batchId, studentId])
  @@index([studentId])
  @@index([admissionId])
}

model ClassSession {
  id              String    @id @default(cuid())
  batchId         String
  batchModuleId   String?
  facultyId       String
  branchId        String
  title           String?   @default("Class Session")
  scheduledDate   DateTime
  startTime       String
  endTime         String
  actualStartTime DateTime?
  actualEndTime   DateTime?
  roomNo          String?
  mode            String?   @default("OFFLINE")
  meetingUrl      String?
  notes           String?
  sessionStatus   String?   @default("UPCOMING")
  status          Status    @default(ACTIVE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  batch       Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchModule BatchModule? @relation(fields: [batchModuleId], references: [id], onDelete: SetNull)
  faculty     Faculty      @relation(fields: [facultyId], references: [id], onDelete: Restrict)

  attendance        StudentAttendance[]
  facultyAttendance FacultyAttendance[]
  recording         Recording?
  googleMeetSpace   GoogleMeetSpace?
  assignments       Assignment[]
  feedback          Feedback[]

  @@index([batchId])
  @@index([facultyId])
  @@index([scheduledDate])
}

model StudentAttendance {
  id             String   @id @default(cuid())
  classSessionId String
  studentId      String
  status         String
  markedAt       DateTime @default(now())
  markedBy       String?
  remarks        String?

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, studentId])
  @@index([studentId])
  @@index([classSessionId])
}

model FacultyAttendance {
  id             String    @id @default(cuid())
  facultyId      String
  classSessionId String
  loginAt        DateTime?
  logoutAt       DateTime?

  faculty      Faculty      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@unique([facultyId, classSessionId])
}

model Recording {
  id                       String    @id @default(cuid())
  classSessionId           String    @unique
  storageKey               String    @default("")
  googleConferenceRecordId String?
  googleRecordingId        String?   @unique
  googleDriveFileId        String?
  playbackUrl              String?
  duration                 Int?
  startedAt                DateTime?
  endedAt                  DateTime?
  expiresAt                DateTime
  recordingStatus          String    @default("PENDING") // PENDING, RECORDING, PROCESSING, READY, FAILED, DELETED
  storageProvider          String    @default("GOOGLE_DRIVE")
  metadata                 Json?
  status                   Status    @default(ACTIVE)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @default(now()) @updatedAt

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@index([googleRecordingId])
  @@index([googleDriveFileId])
  @@index([recordingStatus])
}

model GoogleWorkspaceConnection {
  id                    String                 @id @default(cuid())
  userId                String                 @unique
  instituteId           String
  googleAccountId       String?
  email                 String
  encryptedRefreshToken String
  scopes                String[]               @default([])
  status                GoogleConnectionStatus @default(CONNECTED)
  lastSyncedAt          DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([email])
}

model GoogleMeetSpace {
  id                           String              @id @default(cuid())
  classSessionId               String              @unique
  spaceName                    String              // e.g. "spaces/xxx-yyyy-zzz"
  meetingUri                   String              // e.g. "https://meet.google.com/xxx-yyyy-zzz"
  meetingCode                  String?             // e.g. "xxx-yyyy-zzz"
  organizerUserId              String
  recordingEnabled             Boolean             @default(false)
  recordingConfigurationStatus MeetRecordingStatus @default(UNKNOWN)
  status                       MeetSpaceStatus     @default(ACTIVE)
  config                       Json?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  organizer    User         @relation(fields: [organizerUserId], references: [id], onDelete: Cascade)

  @@index([spaceName])
  @@index([organizerUserId])
}

model Assignment {
  id             String    @id @default(cuid())
  classSessionId String
  batchId        String
  facultyId      String
  title          String
  description    String?
  dueDate        DateTime?
  status         Status    @default(ACTIVE)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  classSession ClassSession           @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  submissions  AssignmentSubmission[]

  @@index([batchId])
  @@index([facultyId])
}

model AssignmentSubmission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  submittedAt  DateTime?
  fileKey      String?
  marks        Float?
  feedback     String?
  evaluatedAt  DateTime?
  evaluatedBy  String?
  status       Status    @default(ACTIVE)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model Feedback {
  id             String   @id @default(cuid())
  classSessionId String
  studentId      String
  facultyId      String
  rating         Int
  comment        String?
  submittedAt    DateTime @default(now())

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, studentId])
  @@index([facultyId])
}

model WhatsappLog {
  id          String   @id @default(cuid())
  waMessageId String?  @unique
  from        String
  to          String?
  type        String
  body        String
  direction   String   // INBOUND | OUTBOUND
  status      String?
  createdAt   DateTime @default(now())

  @@index([from])
}

model CallLog {
  id             String   @id @default(cuid())
  externalCallId String?  @unique
  studentId      String?
  status         String
  duration       Int      @default(0)
  transcript     String?
  createdAt      DateTime @default(now())

  leadId         String?
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([leadId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  instituteId String
  action      String
  entityType  String
  entityId    String
  oldData     Json?
  newData     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([instituteId])
  @@index([entityType, entityId])
}

// ─── Notification System ────────────────────────────────────────────────────

model NotificationTemplate {
  id                   String   @id @default(cuid())
  name                 String   @unique
  event                String
  providerTemplateName String
  language             String   @default("en")
  variables            Json     // string[] of required variable names
  status               String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  notifications Notification[]

  @@index([event])
  @@index([status])
}

model NotificationRule {
  id            String   @id @default(cuid())
  event         String
  channel       String   @default("WHATSAPP")
  enabled       Boolean  @default(true)
  configuration Json?    // e.g. { "offsetMinutes": -120 } for CLASS_REMINDER
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([event, channel])
  @@index([event])
}

model Notification {
  id                String            @id @default(cuid())
  instituteId       String
  branchId          String?
  userId            String?
  studentId         String?
  title             String?
  message           String?
  type              NotificationType? @default(SYSTEM)
  link              String?
  isRead            Boolean           @default(false)
  event             String?
  channel           String            @default("WHATSAPP")
  templateId        String?
  status            String            @default("PENDING")
  scheduledAt       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  providerMessageId String?
  errorMessage      String?
  metadata          Json?
  retryCount        Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  institute Institute             @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user      User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  student   Student?              @relation(fields: [studentId], references: [id], onDelete: SetNull)
  template  NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([studentId])
  @@index([event])
  @@index([status])
  @@index([instituteId])
  @@index([branchId])
  @@index([isRead])
  @@index([scheduledAt])
  @@index([providerMessageId])
}

model NotificationIdempotency {
  id        String   @id @default(cuid())
  key       String   @unique
  createdAt DateTime @default(now())

  @@index([key])
}
model Payment {
  id             String        @id @default(cuid())
  receiptNo      String        @unique
  instituteId    String
  branchId       String?
  studentId      String?
  admissionId    String?
  pendingFeeId   String?
  studentName    String
  admissionNo    String
  courseName     String
  amount         Float
  date           DateTime      @default(now())
  method         PaymentMethod @default(UPI)
  transactionRef String?
  status         PaymentStatus @default(SUCCESS)
  notes          String?
  recordedById   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  institute  Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  student    Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  admission  Admission?  @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  pendingFee PendingFee? @relation(fields: [pendingFeeId], references: [id], onDelete: SetNull)

  @@index([instituteId])
  @@index([branchId])
  @@index([studentId])
  @@index([admissionId])
  @@index([receiptNo])
}

model PendingFee {
  id            String        @id @default(cuid())
  instituteId   String
  branchId      String?
  studentId     String?
  admissionId   String?
  studentName   String
  admissionNo   String
  phone         String
  courseName    String
  totalFee      Float
  amountPaid    Float         @default(0)
  dueAmount     Float
  dueDate       DateTime
  installmentNo Int           @default(1)
  overdueDays   Int           @default(0)
  status        OverdueStatus @default(DUE_SOON)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  institute Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  student   Student?   @relation(fields: [studentId], references: [id], onDelete: SetNull)
  admission Admission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  payments  Payment[]

  @@index([instituteId])
  @@index([branchId])
  @@index([studentId])
  @@index([admissionId])
}

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  designation           String?  @default("")
  department            String?  @default("")
  language              String?  @default("English (US)")
  timezone              String?  @default("(GMT+05:30) India Standard Time")
  twoFactorEnabled      Boolean  @default(false)
  emailAdmissions       Boolean  @default(true)
  emailFeeAlerts        Boolean  @default(true)
  emailAttendance       Boolean  @default(false)
  whatsappReminders     Boolean  @default(true)
  aiCallAlerts          Boolean  @default(true)
  primaryBranch         String?  @default("")
  currencyFormat        String?  @default("INR (₹)")
  themeMode             String?  @default("LIGHT")
  autoLogoutMinutes     Int?     @default(30)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  ADMISSION
  PAYMENT
  ATTENDANCE
  DISCONTINUATION_RISK
  CLASS_SESSION
  ASSIGNMENT
  AI_CALL
  SYSTEM
}

// ─── Lead Management Module (Counsellor System) ─────────────────────────────

enum LeadSource {
  ONLINE
  OFFLINE
  WALK_IN
  PHONE_CALL
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  GOOGLE
  REFERRAL
  AI_CALLING
  OTHER
}

enum LeadStage {
  NEW
  ASSIGNED
  CONTACTED
  INTERESTED
  FOLLOW_UP
  CONVERTED
  LOST
}

enum LeadStatus {
  ACTIVE
  CONVERTED
  LOST
  ARCHIVED
}

enum LeadLostReason {
  PRICE_HIGH
  NOT_INTERESTED
  JOINED_COMPETITOR
  NO_RESPONSE
  COURSE_NOT_AVAILABLE
  LOCATION_ISSUE
  TIMING_ISSUE
  OTHER
}

enum FollowUpType {
  CALL
  WHATSAPP
  MEETING
  REMINDER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  MISSED
  CANCELLED
}

enum LeadActivityType {
  LEAD_CREATED
  LEAD_ASSIGNED
  STAGE_CHANGED
  NOTE_ADDED
  FOLLOW_UP_CREATED
  FOLLOW_UP_COMPLETED
  FOLLOW_UP_MISSED
  CALL_COMPLETED
  WHATSAPP_SENT
  CONVERTED
  MARKED_LOST
}

model Lead {
  id                   String          @id @default(cuid())
  instituteId          String
  branchId             String
  name                 String
  phoneNumber          String
  email                String?
  interestedIn         String          // Text entered by counsellor
  courseId             String?         // Matched course relation if found
  source               LeadSource      @default(WALK_IN)
  stage                LeadStage       @default(ASSIGNED)
  status               LeadStatus      @default(ACTIVE)
  priority             String          @default("MEDIUM") // LOW, MEDIUM, HIGH
  notes                String?
  createdById          String
  assignedCounsellorId String?
  lastContactedAt      DateTime?
  nextFollowUpAt       DateTime?
  convertedAt          DateTime?
  convertedStudentId   String?
  convertedAdmissionId String?
  lostAt               DateTime?
  lostReason           LeadLostReason?
  lostNotes            String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  institute            Institute       @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch               Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  course               Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy            User            @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  assignedCounsellor   User?           @relation("LeadAssignedTo", fields: [assignedCounsellorId], references: [id], onDelete: SetNull)
  convertedStudent     Student?        @relation(fields: [convertedStudentId], references: [id], onDelete: SetNull)
  convertedAdmission   Admission?      @relation(fields: [convertedAdmissionId], references: [id], onDelete: SetNull)

  assignments          LeadAssignment[]
  stageHistory         LeadStageHistory[]
  activities           LeadActivity[]
  followUps            LeadFollowUp[]
  callLogs             CallLog[]

  @@index([instituteId])
  @@index([branchId])
  @@index([instituteId, branchId])
  @@index([phoneNumber])
  @@index([stage])
  @@index([status])
  @@index([source])
  @@index([assignedCounsellorId])
  @@index([createdById])
  @@index([nextFollowUpAt])
  @@index([createdAt])
}

model LeadAssignment {
  id             String    @id @default(cuid())
  leadId         String
  counsellorId   String
  assignedById   String
  assignedAt     DateTime  @default(now())
  unassignedAt   DateTime?
  isCurrent      Boolean   @default(true)
  notes          String?
  createdAt      DateTime  @default(now())

  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  counsellor     User      @relation("LeadAssignmentCounsellor", fields: [counsellorId], references: [id], onDelete: Cascade)
  assignedBy     User      @relation("LeadAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([counsellorId])
  @@index([isCurrent])
}

model LeadStageHistory {
  id          String     @id @default(cuid())
  leadId      String
  fromStage   LeadStage?
  toStage     LeadStage
  changedById String
  notes       String?
  createdAt   DateTime   @default(now())

  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy   User       @relation(fields: [changedById], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
}

model LeadActivity {
  id          String           @id @default(cuid())
  leadId      String
  userId      String?
  type        LeadActivityType
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime         @default(now())

  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([type])
  @@index([createdAt])
}

model LeadFollowUp {
  id           String         @id @default(cuid())
  leadId       String
  counsellorId String
  createdById  String
  type         FollowUpType   @default(CALL)
  status       FollowUpStatus @default(PENDING)
  scheduledAt  DateTime
  completedAt  DateTime?
  notes        String?
  outcome      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  lead         Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  counsellor   User           @relation("FollowUpCounsellor", fields: [counsellorId], references: [id], onDelete: Cascade)
  createdBy    User           @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([counsellorId])
  @@index([status])
  @@index([scheduledAt])
}

model AIConversation {
  id           String      @id @default(cuid())
  instituteId  String
  userId       String
  title        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  messages     AIMessage[]

  institute    Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, instituteId])
  @@index([updatedAt])
}

model AIMessage {
  id              String         @id @default(cuid())
  conversationId  String
  role            String         // "user" | "assistant" | "system" | "tool"
  content         String
  toolName        String?
  toolCallId      String?
  toolArgs        Json?
  toolResult      Json?
  createdAt       DateTime       @default(now())

  conversation    AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ─── Per-User Module Permissions (for CENTER_MANAGER granular access) ────────

model UserPermission {
  id           String   @id @default(cuid())
  userId       String
  permissionId String
  grantedAt    DateTime @default(now())
  grantedById  String?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("PermissionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, permissionId])
  @@index([userId])
}

// ─── Master Module / Master Data Management ──────────────────────────────────

model MasterRecord {
  id          String    @id @default(cuid())
  instituteId String
  branchId    String?
  entityType  String    // e.g. "classroom", "leadsource", "leadstage", "feehead", etc.
  code        String?
  name        String
  description String?
  status      Status    @default(ACTIVE)
  sortOrder   Int       @default(0)
  data        Json?     // Custom entity-specific key-values (capacity, color, slaHours, etc.)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([instituteId, entityType, name])
  @@index([instituteId, entityType])
  @@index([branchId, entityType])
  @@index([entityType, status])
  @@index([createdAt])
}

// ─── Internal Team Chat ──────────────────────────────────────────────────────

enum ConversationType {
  TEAM
  DIRECT
}

model Conversation {
  id          String           @id @default(cuid())
  instituteId String
  branchId    String?
  type        ConversationType @default(DIRECT)
  title       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  institute   Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch      Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)

  members     ConversationMember[]
  messages    Message[]

  @@index([instituteId])
  @@index([branchId])
  @@index([type])
  @@index([updatedAt])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}






