generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum StudentStatus {
  ACTIVE
  ON_LEAVE
  COMPLETED
  DISCONTINUED
  CANCELLED
}

enum FacultyStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum AdmissionStatus {
  CONFIRMED
  PROVISIONAL
  CANCELLED
  PENDING
  ACTIVE
  COMPLETED
}

enum EnquirySource {
  WEBSITE
  WHATSAPP
  WALK_IN
  REFERRAL
  SOCIAL_MEDIA
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  FOLLOW_UP
  CONVERTED
  REJECTED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ADMITTED
}

enum FeeStatus {
  PAID
  PENDING
}

enum FeePlan {
  FULL_PAYMENT
  INSTALLMENT
}

enum PaymentMethod {
  UPI
  NET_BANKING
  CARD
  CASH
  CHEQUE
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
}

enum OverdueStatus {
  OVERDUE
  DUE_SOON
  PARTIAL
  PAID
}


enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

model Institute {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  email     String?
  phone     String?
  address   String?
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches   Branch[]
  users      User[]
  students   Student[]
  faculty    Faculty[]
  courses    Course[]
  admissions Admission[]
  enquiries  Enquiry[]
  applications Application[]

  batches    Batch[]

  payments    Payment[]
  pendingFees PendingFee[]

  createdAtLogs ActivityLog[]
}

model Branch {
  id          String   @id @default(cuid())
  instituteId String
  name        String
  code        String
  address     String?
  phone       String?
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  users      User[]
  students   Student[]
  faculty    Faculty[]
  admissions Admission[]
  enquiries  Enquiry[]
  applications Application[]

  batches    Batch[]

  payments    Payment[]
  pendingFees PendingFee[]

  @@unique([instituteId, code])
  @@index([instituteId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model User {
  id           String     @id @default(cuid())
  instituteId  String
  branchId     String?
  name         String
  email        String?
  phone        String?
  passwordHash String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  userRoles      UserRole[]
  refreshTokens  RefreshToken[]
  student        Student?
  faculty        Faculty?
  assignedEnquiries Enquiry[]


  activityLogs   ActivityLog[]

  @@index([instituteId])
  @@index([branchId])
  @@index([instituteId, branchId])
  @@index([email])
  @@index([phone])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Student {
  id            String        @id @default(cuid())
  userId        String?       @unique
  instituteId   String
  branchId      String
  studentCode   String
  dateOfBirth   DateTime?
  qualification String?
  status        StudentStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  admissions            Admission[]
  batchEnrollments      BatchEnrollment[]
  studentAttendances    StudentAttendance[]
  assignmentSubmissions AssignmentSubmission[]
  feedbacks             Feedback[]
  callLogs              CallLog[]
  payments              Payment[]
  pendingFees           PendingFee[]

  @@unique([instituteId, studentCode])
  @@index([instituteId])
  @@index([branchId])
  @@index([instituteId, branchId])
}

model Faculty {
  id             String        @id @default(cuid())
  userId         String        @unique
  instituteId    String
  branchId       String
  employeeCode   String
  specialization String?
  status         FacultyStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  batches           Batch[]
  classSessions     ClassSession[]
  facultyAttendance FacultyAttendance[]

  @@unique([instituteId, employeeCode])
  @@index([instituteId])
  @@index([branchId])
  @@index([instituteId, branchId])
}

model Course {
  id          String   @id @default(cuid())
  instituteId String
  name        String
  code        String
  description String?
  duration    Int?
  category    String?  @default("Web Development")
  mode        String?  @default("HYBRID")
  level       String?  @default("BEGINNER")
  totalHours  Int?     @default(100)
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  modules    CourseModule[]
  admissions Admission[]
  enquiries  Enquiry[]
  applications Application[]

  batches    Batch[]

  @@unique([instituteId, code])
  @@index([instituteId])
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  name        String
  code        String?
  description String?
  sequence    Int
  duration    Int?
  topics      Json?
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  batchModules BatchModule[]

  @@unique([courseId, sequence])
  @@index([courseId])
}

model Enquiry {
  id             String        @id @default(cuid())
  instituteId    String
  branchId       String?
  enquiryNo      String?
  name           String
  email          String?
  phone          String
  courseId       String
  source         EnquirySource @default(WEBSITE)
  status         EnquiryStatus @default(NEW)
  counselorNotes String?
  assignedToId   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  institute  Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  assignedTo User?       @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  applications Application[]

  @@index([instituteId])
  @@index([branchId])
  @@index([courseId])
  @@index([assignedToId])
}

model Application {
  id            String            @id @default(cuid())
  instituteId   String
  branchId      String?
  applicationNo String            @unique
  enquiryId     String?
  applicantName String
  email         String?
  phone         String
  courseId      String
  feeStatus     FeeStatus         @default(PENDING)
  status        ApplicationStatus @default(SUBMITTED)
  submittedDate DateTime          @default(now())
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  institute  Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enquiry    Enquiry?    @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  admissions Admission[]

  @@index([instituteId])
  @@index([branchId])
  @@index([courseId])
  @@index([enquiryId])
}

model Admission {
  id            String          @id @default(cuid())
  admissionNo   String?         @unique
  studentId     String?
  applicationId String?
  instituteId   String
  branchId      String
  courseId      String
  batchId       String?
  studentName   String?
  email         String?
  phone         String?
  feePlan       FeePlan         @default(INSTALLMENT)
  status        AdmissionStatus @default(CONFIRMED)
  admissionDate DateTime        @default(now())
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  student     Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  institute   Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batch       Batch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)

  batchEnrollments BatchEnrollment[]
  payments         Payment[]
  pendingFees      PendingFee[]

  @@index([studentId])
  @@index([applicationId])
  @@index([instituteId])
  @@index([branchId])
  @@index([courseId])
  @@index([batchId])
}

model Batch {
  id              String      @id @default(cuid())
  instituteId     String
  branchId        String
  courseId        String
  facultyId       String?
  name            String
  code            String
  startDate       DateTime
  expectedEndDate DateTime?
  schedulePattern String?     @default("MWF")
  timeSlot        String?     @default("10:00 AM - 12:00 PM")
  capacity        Int         @default(35)
  status          BatchStatus @default(UPCOMING)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  faculty   Faculty?  @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  schedules     BatchSchedule[]
  batchModules  BatchModule[]
  enrollments   BatchEnrollment[]
  classSessions ClassSession[]
  admissions    Admission[]


  @@unique([instituteId, code])
  @@index([instituteId])
  @@index([branchId])
  @@index([instituteId, branchId])
  @@index([courseId])
  @@index([facultyId])
}

model BatchSchedule {
  id            String    @id @default(cuid())
  batchId       String
  dayOfWeek     Int
  startTime     String
  endTime       String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

model BatchModule {
  id             String    @id @default(cuid())
  batchId        String
  courseModuleId String
  sequence       Int
  startDate      DateTime?
  endDate        DateTime?
  status         Status    @default(ACTIVE)
  createdAt      DateTime  @default(now())

  batch        Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  courseModule CourseModule @relation(fields: [courseModuleId], references: [id], onDelete: Restrict)

  classSessions ClassSession[]

  @@unique([batchId, sequence])
  @@index([batchId])
  @@index([courseModuleId])
}

model BatchEnrollment {
  id          String    @id @default(cuid())
  batchId     String
  studentId   String
  admissionId String?
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now())

  batch     Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  admission Admission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)

  @@unique([batchId, studentId])
  @@index([studentId])
  @@index([admissionId])
}

model ClassSession {
  id              String    @id @default(cuid())
  batchId         String
  batchModuleId   String?
  facultyId       String
  branchId        String
  title           String?   @default("Class Session")
  scheduledDate   DateTime
  startTime       String
  endTime         String
  actualStartTime DateTime?
  actualEndTime   DateTime?
  roomNo          String?
  mode            String?   @default("OFFLINE")
  meetingUrl      String?
  notes           String?
  sessionStatus   String?   @default("UPCOMING")
  status          Status    @default(ACTIVE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  batch       Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchModule BatchModule? @relation(fields: [batchModuleId], references: [id], onDelete: SetNull)
  faculty     Faculty      @relation(fields: [facultyId], references: [id], onDelete: Restrict)

  attendance        StudentAttendance[]
  facultyAttendance FacultyAttendance[]
  recording         Recording?
  assignments       Assignment[]
  feedback          Feedback[]

  @@index([batchId])
  @@index([facultyId])
  @@index([scheduledDate])
}

model StudentAttendance {
  id             String   @id @default(cuid())
  classSessionId String
  studentId      String
  status         String
  markedAt       DateTime @default(now())
  markedBy       String?
  remarks        String?

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, studentId])
  @@index([studentId])
}

model FacultyAttendance {
  id             String    @id @default(cuid())
  facultyId      String
  classSessionId String
  loginAt        DateTime?
  logoutAt       DateTime?

  faculty      Faculty      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@unique([facultyId, classSessionId])
}

model Recording {
  id             String    @id @default(cuid())
  classSessionId String    @unique
  storageKey     String
  duration       Int?
  startedAt      DateTime?
  endedAt        DateTime?
  expiresAt      DateTime
  status         Status    @default(ACTIVE)
  createdAt      DateTime  @default(now())

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
}

model Assignment {
  id             String    @id @default(cuid())
  classSessionId String
  batchId        String
  facultyId      String
  title          String
  description    String?
  dueDate        DateTime?
  status         Status    @default(ACTIVE)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  classSession ClassSession           @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  submissions  AssignmentSubmission[]

  @@index([batchId])
  @@index([facultyId])
}

model AssignmentSubmission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  submittedAt  DateTime?
  fileKey      String?
  marks        Float?
  feedback     String?
  evaluatedAt  DateTime?
  evaluatedBy  String?
  status       Status    @default(ACTIVE)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model Feedback {
  id             String   @id @default(cuid())
  classSessionId String
  studentId      String
  facultyId      String
  rating         Int
  comment        String?
  submittedAt    DateTime @default(now())

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, studentId])
  @@index([facultyId])
}

model WhatsappLog {
  id          String   @id @default(cuid())
  waMessageId String?  @unique
  from        String
  to          String?
  type        String
  body        String
  direction   String   // INBOUND | OUTBOUND
  status      String?
  createdAt   DateTime @default(now())

  @@index([from])
}

model CallLog {
  id             String   @id @default(cuid())
  externalCallId String?  @unique
  studentId      String?
  status         String
  duration       Int      @default(0)
  transcript     String?
  createdAt      DateTime @default(now())

  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([studentId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  instituteId String
  action      String
  entityType  String
  entityId    String
  oldData     Json?
  newData     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([instituteId])
  @@index([entityType, entityId])
}

model Payment {
  id             String        @id @default(cuid())
  receiptNo      String        @unique
  instituteId    String
  branchId       String?
  studentId      String?
  admissionId    String?
  pendingFeeId   String?
  studentName    String
  admissionNo    String
  courseName     String
  amount         Float
  date           DateTime      @default(now())
  method         PaymentMethod @default(UPI)
  transactionRef String?
  status         PaymentStatus @default(SUCCESS)
  notes          String?
  recordedById   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  institute  Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  student    Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  admission  Admission?  @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  pendingFee PendingFee? @relation(fields: [pendingFeeId], references: [id], onDelete: SetNull)

  @@index([instituteId])
  @@index([branchId])
  @@index([studentId])
  @@index([admissionId])
  @@index([receiptNo])
}

model PendingFee {
  id            String        @id @default(cuid())
  instituteId   String
  branchId      String?
  studentId     String?
  admissionId   String?
  studentName   String
  admissionNo   String
  phone         String
  courseName    String
  totalFee      Float
  amountPaid    Float         @default(0)
  dueAmount     Float
  dueDate       DateTime
  installmentNo Int           @default(1)
  overdueDays   Int           @default(0)
  status        OverdueStatus @default(DUE_SOON)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  institute Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  student   Student?   @relation(fields: [studentId], references: [id], onDelete: SetNull)
  admission Admission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  payments  Payment[]

  @@index([instituteId])
  @@index([branchId])
  @@index([studentId])
  @@index([admissionId])
}

