generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum StudentStatus {
  ACTIVE
  ON_LEAVE
  COMPLETED
  DISCONTINUED
  CANCELLED
}

enum FacultyStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum AdmissionStatus {
  CONFIRMED
  PROVISIONAL
  CANCELLED
  PENDING
  ACTIVE
  COMPLETED
}

enum EnquirySource {
  WEBSITE
  WHATSAPP
  WALK_IN
  REFERRAL
  SOCIAL_MEDIA
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  FOLLOW_UP
  CONVERTED
  REJECTED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ADMITTED
}

enum FeeStatus {
  PAID
  PENDING
}

enum FeePlan {
  FULL_PAYMENT
  INSTALLMENT
}

enum PaymentMethod {
  UPI
  NET_BANKING
  CARD
  CASH
  CHEQUE
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
}

enum OverdueStatus {
  OVERDUE
  DUE_SOON
  PARTIAL
  PAID
}


enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SessionType {
  THEORY
  PRACTICAL
}

enum ClassSessionStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum GoogleConnectionStatus {
  CONNECTED
  REAUTH_REQUIRED
  DISCONNECTED
  EXPIRED
}

enum MeetRecordingStatus {
  ENABLED
  DISABLED
  NOT_SUPPORTED
  PERMISSION_DENIED
  UNKNOWN
}

enum MeetSpaceStatus {
  ACTIVE
  ENDED
  CANCELLED
}

model Institute {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  email     String?
  phone     String?
  address   String?
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches   Branch[]
  users      User[]
  students   Student[]
  faculty    Faculty[]
  courses    Course[]
  admissions Admission[]
  enquiries  Enquiry[]
  applications Application[]

  batches    Batch[]

  payments    Payment[]
  pendingFees PendingFee[]
  createdAtLogs ActivityLog[]
  notifications Notification[]
  leads       Lead[]
  aiConversations AIConversation[]
  masterRecords MasterRecord[]
  googleConnections GoogleWorkspaceConnection[]
  conversations Conversation[]
  targetPlans TargetPlan[]
  targets     Target[]
  incentives  Incentive[]
  exams       Exam[]
  questions   Question[]
  questionBanks QuestionBank[]
  examAttempts ExamAttempt[]
  examProctoringEvents ExamProctoringEvent[]
  documents            Document[]
  feePlanTemplates     FeePlanTemplate[]
  placementCompanies   PlacementCompany[]
  placementJobs        PlacementJob[]
  placementApplications PlacementApplication[]
  placementRecords     PlacementRecord[]
  emailTemplates       EmailTemplate[]
  emailLogs            EmailLog[]
  subscriptions        Subscription[]
  invoices             Invoice[]
}

model Branch {
  id          String   @id @default(cuid())
  instituteId String
  name        String
  code        String
  address     String?
  phone       String?
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  users      User[]
  students   Student[]
  faculty    Faculty[]
  admissions Admission[]
  enquiries  Enquiry[]
  applications Application[]

  batches    Batch[]

  payments    Payment[]
  pendingFees PendingFee[]
  notifications Notification[]
  leads       Lead[]
  masterRecords MasterRecord[]
  conversations Conversation[]
  targetPlans TargetPlan[]
  targets     Target[]
  incentives  Incentive[]
  exams       Exam[]
  questions   Question[]
  questionBanks QuestionBank[]
  examAttempts ExamAttempt[]
  documents             Document[]
  feePlanTemplates      FeePlanTemplate[]
  placementApplications PlacementApplication[]
  placementRecords      PlacementRecord[]

  @@unique([instituteId, code])
  @@index([instituteId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model User {
  id              String     @id @default(cuid())
  instituteId     String
  branchId        String?
  name            String
  email           String?
  phone           String?
  passwordHash    String
  status          UserStatus @default(ACTIVE)
  whatsappEnabled Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  userRoles      UserRole[]
  userPermissions UserPermission[]
  refreshTokens  RefreshToken[]
  student        Student?
  faculty        Faculty?
  assignedEnquiries Enquiry[]
  settings UserSettings?

  activityLogs   ActivityLog[]
  notifications  Notification[]

  createdLeads         Lead[]             @relation("LeadCreatedBy")
  assignedLeads        Lead[]             @relation("LeadAssignedTo")
  assignedLeadRecords  LeadAssignment[]   @relation("LeadAssignmentCounsellor")
  assignmentsGiven     LeadAssignment[]   @relation("LeadAssignmentAssignedBy")
  stageChanges         LeadStageHistory[]
  leadActivities       LeadActivity[]
  followUpsAssigned    LeadFollowUp[]     @relation("FollowUpCounsellor")
  followUpsCreated     LeadFollowUp[]     @relation("FollowUpCreatedBy")
  aiConversations      AIConversation[]
  permissionsGranted   UserPermission[]   @relation("PermissionGrantedBy")
  googleConnection     GoogleWorkspaceConnection?
  organizedMeetSpaces  GoogleMeetSpace[]
  chatMemberships      ConversationMember[]
  sentMessages         Message[]
  createdTargetPlans   TargetPlan[]       @relation("TargetPlanCreatedBy")
  assignedTargets      Target[]           @relation("TargetAssignedTo")
  createdTargets       Target[]           @relation("TargetCreatedBy")
  incentivesEarned     Incentive[]        @relation("IncentiveUser")
  incentivesApproved   Incentive[]        @relation("IncentiveApprovedBy")
  targetProgress       TargetProgress[]
  createdExams         Exam[]             @relation("ExamCreatedBy")
  createdQuestions     Question[]         @relation("QuestionCreatedBy")
  createdQuestionBanks QuestionBank[]     @relation("QuestionBankCreatedBy")
  examAttempts         ExamAttempt[]
  documentsUploaded    Document[]     @relation("DocumentUploadedBy")
  documentsVerified    Document[]     @relation("DocumentVerifiedBy")
  emailLogsSent        EmailLog[]     @relation("EmailLogSentBy")

  @@index([instituteId])
  @@index([branchId])
  @@index([instituteId, branchId])
  @@index([email])
  @@index([phone])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Student {
  id                      String        @id @default(cuid())
  userId                  String?       @unique
  instituteId             String
  branchId                String
  studentCode             String
  dateOfBirth             DateTime?
  qualification           String?
  qualificationMasterId   String?
  areaMasterId            String?
  status                  StudentStatus @default(ACTIVE)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  user                  User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  institute             Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch                Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  qualificationMaster   MasterRecord?  @relation("StudentQualificationMaster", fields: [qualificationMasterId], references: [id], onDelete: SetNull)
  areaMaster            MasterRecord?  @relation("StudentAreaMaster", fields: [areaMasterId], references: [id], onDelete: SetNull)

  admissions            Admission[]
  batchEnrollments      BatchEnrollment[]
  studentAttendances    StudentAttendance[]
  assignmentSubmissions AssignmentSubmission[]
  feedbacks             Feedback[]
  callLogs              CallLog[]
  notifications         Notification[]
  payments              Payment[]
  pendingFees           PendingFee[]
  convertedFromLeads    Lead[]
  examAttempts          ExamAttempt[]
  examAssignments       ExamStudent[]
  placementApplications PlacementApplication[]
  placementRecords      PlacementRecord[]

  @@unique([instituteId, studentCode])
  @@index([instituteId])
  @@index([branchId])
  @@index([instituteId, branchId])
}

model Faculty {
  id                     String        @id @default(cuid())
  userId                 String        @unique
  instituteId            String
  branchId               String
  employeeCode           String
  specialization         String?
  designation            String?
  designationMasterId    String?
  qualification          String?
  qualificationMasterId  String?
  status                 FacultyStatus @default(ACTIVE)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  institute             Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch                Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  designationMaster     MasterRecord? @relation("FacultyDesignationMaster", fields: [designationMasterId], references: [id], onDelete: SetNull)
  qualificationMaster   MasterRecord? @relation("FacultyQualificationMaster", fields: [qualificationMasterId], references: [id], onDelete: SetNull)

  batches           Batch[]
  batchCourses      BatchCourse[]
  classSessions     ClassSession[]
  facultyAttendance FacultyAttendance[]
  assignments       Assignment[]
  feedbacks         Feedback[]

  @@unique([instituteId, employeeCode])
  @@index([instituteId])
  @@index([branchId])
  @@index([instituteId, branchId])
}

model Course {
  id          String   @id @default(cuid())
  instituteId String
  name        String
  code        String
  description String?
  duration    Int?
  category    String?  @default("Web Development")
  mode        String?  @default("HYBRID")
  level       String?  @default("BEGINNER")
  totalHours  Int?     @default(100)
  fee         Float?
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  modules    CourseModule[]
  admissions Admission[]
  enquiries  Enquiry[]
  applications Application[]

  batches    Batch[]
  batchCourses BatchCourse[]
  leads      Lead[]
  exams      Exam[]
  questions  Question[]
  questionBanks QuestionBank[]
  feePlanTemplates FeePlanTemplate[]

  @@unique([instituteId, code])
  @@index([instituteId])
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  name        String
  code        String?
  description String?
  sequence    Int
  duration    Int?
  topics      Json?
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  batchModules BatchModule[]
  questions    Question[]
  exams        Exam[]

  @@unique([courseId, sequence])
  @@index([courseId])
}

model Enquiry {
  id             String        @id @default(cuid())
  instituteId    String
  branchId       String?
  enquiryNo      String?
  name           String
  email          String?
  phone          String
  courseId       String
  source         String        @default("WEBSITE")
  sourceMasterId String?
  status         EnquiryStatus @default(NEW)
  counselorNotes String?
  assignedToId   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  institute    Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  assignedTo   User?         @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  sourceMaster MasterRecord? @relation("EnquirySourceMaster", fields: [sourceMasterId], references: [id], onDelete: SetNull)
  applications Application[]

  @@index([instituteId])
  @@index([branchId])
  @@index([courseId])
  @@index([assignedToId])
}

model Application {
  id            String            @id @default(cuid())
  instituteId   String
  branchId      String?
  applicationNo String            @unique
  enquiryId     String?
  leadId        String?
  applicantName String
  email         String?
  phone         String
  courseId      String
  feeStatus     FeeStatus         @default(PENDING)
  status        ApplicationStatus @default(SUBMITTED)
  submittedDate DateTime          @default(now())
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  institute  Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enquiry    Enquiry?    @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  lead       Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  admissions Admission[]

  @@index([instituteId])
  @@index([branchId])
  @@index([courseId])
  @@index([enquiryId])
  @@index([leadId])
}

model Admission {
  id                     String    @id @default(cuid())
  admissionNo            String?   @unique
  studentId              String?
  applicationId          String?
  instituteId            String
  branchId               String
  courseId               String
  batchId                String?
  studentName            String?
  email                  String?
  phone                  String?
  feePlan                FeePlan   @default(INSTALLMENT)
  status                 String    @default("CONFIRMED")
  statusMasterId         String?
  concessionHeadMasterId String?
  admissionDate          DateTime  @default(now())
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  student              Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  application          Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  institute            Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch               Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  course               Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batch                Batch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  statusMaster         MasterRecord? @relation("AdmissionStatusMaster", fields: [statusMasterId], references: [id], onDelete: SetNull)
  concessionHeadMaster MasterRecord? @relation("AdmissionConcessionMaster", fields: [concessionHeadMasterId], references: [id], onDelete: SetNull)

  batchEnrollments BatchEnrollment[]
  payments         Payment[]
  pendingFees      PendingFee[]
  convertedFromLeads Lead[]

  @@index([studentId])
  @@index([applicationId])
  @@index([instituteId])
  @@index([branchId])
  @@index([courseId])
  @@index([batchId])
}

model Batch {
  id              String      @id @default(cuid())
  instituteId     String
  branchId        String
  courseId        String
  facultyId       String?
  name            String
  code            String
  startDate       DateTime
  expectedEndDate DateTime?
  schedulePattern String?     @default("MWF")
  timeSlot        String?     @default("10:00 AM - 12:00 PM")
  timeslotMasterId  String?
  classroomMasterId String?
  capacity        Int         @default(35)
  status          BatchStatus @default(UPCOMING)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  faculty   Faculty?  @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  timeslotMaster  MasterRecord? @relation("BatchTimeslotMaster", fields: [timeslotMasterId], references: [id], onDelete: SetNull)
  classroomMaster MasterRecord? @relation("BatchClassroomMaster", fields: [classroomMasterId], references: [id], onDelete: SetNull)

  schedules     BatchSchedule[]
  batchModules  BatchModule[]
  batchCourses  BatchCourse[]
  enrollments   BatchEnrollment[]
  classSessions ClassSession[]
  admissions    Admission[]
  examAssignments ExamBatch[]


  @@unique([instituteId, code])
  @@index([instituteId])
  @@index([branchId])
  @@index([instituteId, branchId])
  @@index([courseId])
  @@index([facultyId])
}

model BatchCourse {
  id        String   @id @default(cuid())
  batchId   String
  courseId  String
  facultyId String?
  sequence  Int      @default(1)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch   Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  faculty Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  @@unique([batchId, courseId])
  @@index([batchId])
  @@index([courseId])
  @@index([facultyId])
}

model BatchSchedule {
  id            String    @id @default(cuid())
  batchId       String
  dayOfWeek     Int
  startTime     String
  endTime       String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

model BatchModule {
  id             String    @id @default(cuid())
  batchId        String
  courseModuleId String
  sequence       Int
  startDate      DateTime?
  endDate        DateTime?
  status         Status    @default(ACTIVE)
  createdAt      DateTime  @default(now())

  batch        Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  courseModule CourseModule @relation(fields: [courseModuleId], references: [id], onDelete: Restrict)

  classSessions ClassSession[]

  @@unique([batchId, sequence])
  @@index([batchId])
  @@index([courseModuleId])
}

model BatchEnrollment {
  id          String    @id @default(cuid())
  batchId     String
  studentId   String
  admissionId String?
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now())

  batch     Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  admission Admission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)

  @@unique([batchId, studentId])
  @@index([studentId])
  @@index([admissionId])
}

model ClassSession {
  id                String    @id @default(cuid())
  batchId           String
  batchModuleId     String?
  facultyId         String
  branchId          String
  title             String?   @default("Class Session")
  scheduledDate     DateTime
  startTime         String
  endTime           String
  actualStartTime   DateTime?
  actualEndTime     DateTime?
  roomNo            String?
  classroomMasterId String?
  timeslotMasterId  String?
  mode              String?   @default("OFFLINE")
  meetingUrl        String?
  notes             String?
  sessionType       SessionType @default(THEORY)
  sessionStatus     ClassSessionStatus @default(UPCOMING)
  status            Status    @default(ACTIVE)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  batch            Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchModule      BatchModule?  @relation(fields: [batchModuleId], references: [id], onDelete: SetNull)
  faculty          Faculty       @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  classroomMaster  MasterRecord? @relation("ClassSessionClassroomMaster", fields: [classroomMasterId], references: [id], onDelete: SetNull)
  timeslotMaster   MasterRecord? @relation("ClassSessionTimeslotMaster", fields: [timeslotMasterId], references: [id], onDelete: SetNull)

  attendance        StudentAttendance[]
  facultyAttendance FacultyAttendance[]
  recording         Recording?
  googleMeetSpace   GoogleMeetSpace?
  assignments       Assignment[]
  feedback          Feedback[]

  @@index([batchId])
  @@index([facultyId])
  @@index([scheduledDate])
}

model StudentAttendance {
  id             String   @id @default(cuid())
  classSessionId String
  studentId      String
  status         String
  markedAt       DateTime @default(now())
  markedBy       String?
  remarks        String?

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, studentId])
  @@index([studentId])
  @@index([classSessionId])
}

model FacultyAttendance {
  id             String    @id @default(cuid())
  facultyId      String
  classSessionId String
  loginAt        DateTime?
  logoutAt       DateTime?

  faculty      Faculty      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@unique([facultyId, classSessionId])
}

model Recording {
  id                       String    @id @default(cuid())
  classSessionId           String    @unique
  storageKey               String    @default("")
  googleConferenceRecordId String?
  googleRecordingId        String?   @unique
  googleDriveFileId        String?
  playbackUrl              String?
  duration                 Int?
  startedAt                DateTime?
  endedAt                  DateTime?
  expiresAt                DateTime
  recordingStatus          String    @default("PENDING") // PENDING, RECORDING, PROCESSING, READY, FAILED, DELETED
  storageProvider          String    @default("GOOGLE_DRIVE")
  metadata                 Json?
  status                   Status    @default(ACTIVE)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @default(now()) @updatedAt

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@index([googleRecordingId])
  @@index([googleDriveFileId])
  @@index([recordingStatus])
}

model GoogleWorkspaceConnection {
  id                    String                 @id @default(cuid())
  userId                String                 @unique
  instituteId           String
  googleAccountId       String?
  email                 String
  encryptedRefreshToken String
  scopes                String[]               @default([])
  status                GoogleConnectionStatus @default(CONNECTED)
  lastSyncedAt          DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([email])
}

model GoogleMeetSpace {
  id                           String              @id @default(cuid())
  classSessionId               String              @unique
  spaceName                    String              // e.g. "spaces/xxx-yyyy-zzz"
  meetingUri                   String              // e.g. "https://meet.google.com/xxx-yyyy-zzz"
  meetingCode                  String?             // e.g. "xxx-yyyy-zzz"
  organizerUserId              String
  recordingEnabled             Boolean             @default(false)
  recordingConfigurationStatus MeetRecordingStatus @default(UNKNOWN)
  status                       MeetSpaceStatus     @default(ACTIVE)
  config                       Json?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  organizer    User         @relation(fields: [organizerUserId], references: [id], onDelete: Cascade)

  @@index([spaceName])
  @@index([organizerUserId])
}

model Assignment {
  id                   String    @id @default(cuid())
  classSessionId       String
  batchId              String
  facultyId            String
  title                String
  description          String?
  assignmentTypeMasterId String?
  dueDate              DateTime?
  status               Status    @default(ACTIVE)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  classSession         ClassSession  @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  faculty              Faculty       @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  assignmentTypeMaster MasterRecord? @relation("AssignmentTypeMaster", fields: [assignmentTypeMasterId], references: [id], onDelete: SetNull)
  submissions          AssignmentSubmission[]

  @@index([batchId])
  @@index([facultyId])
}

model AssignmentSubmission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  submittedAt  DateTime?
  fileKey      String?
  marks        Float?
  feedback     String?
  evaluatedAt  DateTime?
  evaluatedBy  String?
  status       Status    @default(ACTIVE)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model Feedback {
  id             String   @id @default(cuid())
  classSessionId String
  studentId      String
  facultyId      String
  rating         Int
  comment        String?
  submittedAt    DateTime @default(now())

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  faculty      Faculty      @relation(fields: [facultyId], references: [id], onDelete: Restrict)

  @@unique([classSessionId, studentId])
  @@index([facultyId])
}

model WhatsappLog {
  id          String   @id @default(cuid())
  waMessageId String?  @unique
  from        String
  to          String?
  type        String
  body        String
  direction   String   // INBOUND | OUTBOUND
  status      String?
  createdAt   DateTime @default(now())

  @@index([from])
}

model CallLog {
  id             String   @id @default(cuid())
  externalCallId String?  @unique
  studentId      String?
  status         String
  duration       Int      @default(0)
  transcript     String?
  createdAt      DateTime @default(now())

  leadId         String?
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([leadId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  instituteId String
  action      String
  entityType  String
  entityId    String
  oldData     Json?
  newData     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([instituteId])
  @@index([entityType, entityId])
}

// ─── Notification System ────────────────────────────────────────────────────

model NotificationTemplate {
  id                   String   @id @default(cuid())
  name                 String   @unique
  event                String
  providerTemplateName String
  language             String   @default("en")
  variables            Json     // string[] of required variable names
  status               String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  notifications Notification[]

  @@index([event])
  @@index([status])
}

model NotificationRule {
  id            String   @id @default(cuid())
  event         String
  channel       String   @default("WHATSAPP")
  enabled       Boolean  @default(true)
  configuration Json?    // e.g. { "offsetMinutes": -120 } for CLASS_REMINDER
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([event, channel])
  @@index([event])
}

model Notification {
  id                String            @id @default(cuid())
  instituteId       String
  branchId          String?
  userId            String?
  studentId         String?
  title             String?
  message           String?
  type              NotificationType? @default(SYSTEM)
  link              String?
  isRead            Boolean           @default(false)
  event             String?
  channel           String            @default("WHATSAPP")
  templateId        String?
  status            String            @default("PENDING")
  scheduledAt       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  providerMessageId String?
  errorMessage      String?
  metadata          Json?
  retryCount        Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  institute Institute             @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user      User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  student   Student?              @relation(fields: [studentId], references: [id], onDelete: SetNull)
  template  NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([studentId])
  @@index([event])
  @@index([status])
  @@index([instituteId])
  @@index([branchId])
  @@index([isRead])
  @@index([scheduledAt])
  @@index([providerMessageId])
}

model NotificationIdempotency {
  id        String   @id @default(cuid())
  key       String   @unique
  createdAt DateTime @default(now())

  @@index([key])
}
model Payment {
  id                   String        @id @default(cuid())
  receiptNo            String        @unique
  instituteId          String
  branchId             String?
  studentId            String?
  admissionId          String?
  pendingFeeId         String?
  studentName          String
  admissionNo          String
  courseName           String
  amount               Float
  date                 DateTime      @default(now())
  method               String        @default("UPI")
  paymentModeMasterId  String?
  bankAccountMasterId  String?
  feeHeadMasterId      String?
  feeHead              String?
  transactionRef       String?
  status               PaymentStatus @default(SUCCESS)
  notes                String?
  recordedById         String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  institute           Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch              Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  student             Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  admission           Admission?    @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  pendingFee          PendingFee?   @relation(fields: [pendingFeeId], references: [id], onDelete: SetNull)
  paymentModeMaster   MasterRecord? @relation("PaymentModeMaster", fields: [paymentModeMasterId], references: [id], onDelete: SetNull)
  bankAccountMaster   MasterRecord? @relation("PaymentBankAccountMaster", fields: [bankAccountMasterId], references: [id], onDelete: SetNull)
  feeHeadMaster       MasterRecord? @relation("PaymentFeeHeadMaster", fields: [feeHeadMasterId], references: [id], onDelete: SetNull)

  @@index([instituteId])
  @@index([branchId])
  @@index([studentId])
  @@index([admissionId])
  @@index([receiptNo])
}

model PendingFee {
  id              String        @id @default(cuid())
  instituteId     String
  branchId        String?
  studentId       String?
  admissionId     String?
  studentName     String
  admissionNo     String
  phone           String
  courseName      String
  totalFee        Float
  amountPaid      Float         @default(0)
  dueAmount       Float
  dueDate         DateTime
  installmentNo   Int           @default(1)
  overdueDays     Int           @default(0)
  status          OverdueStatus @default(DUE_SOON)
  feeHeadMasterId String?
  feeHead         String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  institute     Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch        Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  student       Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  admission     Admission?    @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  feeHeadMaster MasterRecord? @relation("PendingFeeHeadMaster", fields: [feeHeadMasterId], references: [id], onDelete: SetNull)
  payments      Payment[]

  @@index([instituteId])
  @@index([branchId])
  @@index([studentId])
  @@index([admissionId])
}

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  designation           String?  @default("")
  designationMasterId   String?
  department            String?  @default("")
  language              String?  @default("English (US)")
  timezone              String?  @default("(GMT+05:30) India Standard Time")
  twoFactorEnabled      Boolean  @default(false)
  emailAdmissions       Boolean  @default(true)
  emailFeeAlerts        Boolean  @default(true)
  emailAttendance       Boolean  @default(false)
  whatsappReminders     Boolean  @default(true)
  aiCallAlerts          Boolean  @default(true)
  primaryBranch         String?  @default("")
  currencyFormat        String?  @default("INR (₹)")
  themeMode             String?  @default("LIGHT")
  autoLogoutMinutes     Int?     @default(30)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  designationMaster   MasterRecord? @relation("UserSettingsDesignationMaster", fields: [designationMasterId], references: [id], onDelete: SetNull)
}

enum NotificationType {
  ADMISSION
  PAYMENT
  ATTENDANCE
  DISCONTINUATION_RISK
  CLASS_SESSION
  ASSIGNMENT
  AI_CALL
  SYSTEM
}

// ─── Lead Management Module (Counsellor System) ─────────────────────────────

enum LeadSource {
  ONLINE
  OFFLINE
  WALK_IN
  PHONE_CALL
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  GOOGLE
  REFERRAL
  AI_CALLING
  OTHER
}

enum LeadStage {
  NEW
  ASSIGNED
  CONTACTED
  INTERESTED
  FOLLOW_UP
  CONVERTED
  LOST
}

enum LeadStatus {
  ACTIVE
  CONVERTED
  LOST
  ARCHIVED
}

enum LeadLostReason {
  PRICE_HIGH
  NOT_INTERESTED
  JOINED_COMPETITOR
  NO_RESPONSE
  COURSE_NOT_AVAILABLE
  LOCATION_ISSUE
  TIMING_ISSUE
  OTHER
}

enum FollowUpType {
  CALL
  WHATSAPP
  MEETING
  REMINDER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  MISSED
  CANCELLED
}

enum LeadActivityType {
  LEAD_CREATED
  LEAD_ASSIGNED
  STAGE_CHANGED
  NOTE_ADDED
  FOLLOW_UP_CREATED
  FOLLOW_UP_COMPLETED
  FOLLOW_UP_MISSED
  CALL_COMPLETED
  WHATSAPP_SENT
  CONVERTED
  MARKED_LOST
}

model Lead {
  id                   String          @id @default(cuid())
  instituteId          String
  branchId             String
  name                 String
  phoneNumber          String
  email                String?
  interestedIn         String          // Text entered by counsellor
  courseId             String?         // Matched course relation if found
  source               String          @default("WALK_IN")
  sourceMasterId       String?
  stage                String          @default("NEW")
  stageMasterId        String?
  leadTypeMasterId     String?
  status               LeadStatus      @default(ACTIVE)
  priority             String          @default("MEDIUM") // LOW, MEDIUM, HIGH
  notes                String?
  createdById          String
  assignedCounsellorId String?
  lastContactedAt      DateTime?
  nextFollowUpAt       DateTime?
  convertedAt          DateTime?
  convertedStudentId   String?
  convertedAdmissionId String?
  lostAt               DateTime?
  lostReason           LeadLostReason?
  lostNotes            String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  institute            Institute       @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch               Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  course               Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy            User            @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  assignedCounsellor   User?           @relation("LeadAssignedTo", fields: [assignedCounsellorId], references: [id], onDelete: SetNull)
  convertedStudent     Student?        @relation(fields: [convertedStudentId], references: [id], onDelete: SetNull)
  convertedAdmission   Admission?      @relation(fields: [convertedAdmissionId], references: [id], onDelete: SetNull)
  sourceMaster         MasterRecord?   @relation("LeadSourceMaster", fields: [sourceMasterId], references: [id], onDelete: SetNull)
  stageMaster          MasterRecord?   @relation("LeadStageMaster", fields: [stageMasterId], references: [id], onDelete: SetNull)
  leadTypeMaster       MasterRecord?   @relation("LeadTypeMaster", fields: [leadTypeMasterId], references: [id], onDelete: SetNull)

  assignments          LeadAssignment[]
  stageHistory         LeadStageHistory[]
  activities           LeadActivity[]
  followUps            LeadFollowUp[]
  callLogs             CallLog[]
  applications         Application[]

  @@index([instituteId])
  @@index([branchId])
  @@index([instituteId, branchId])
  @@index([phoneNumber])
  @@index([stage])
  @@index([status])
  @@index([source])
  @@index([assignedCounsellorId])
  @@index([createdById])
  @@index([nextFollowUpAt])
  @@index([createdAt])
}

model LeadAssignment {
  id             String    @id @default(cuid())
  leadId         String
  counsellorId   String
  assignedById   String
  assignedAt     DateTime  @default(now())
  unassignedAt   DateTime?
  isCurrent      Boolean   @default(true)
  notes          String?
  createdAt      DateTime  @default(now())

  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  counsellor     User      @relation("LeadAssignmentCounsellor", fields: [counsellorId], references: [id], onDelete: Cascade)
  assignedBy     User      @relation("LeadAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([counsellorId])
  @@index([isCurrent])
}

model LeadStageHistory {
  id          String   @id @default(cuid())
  leadId      String
  fromStage   String?
  toStage     String
  changedById String
  notes       String?
  createdAt   DateTime @default(now())

  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy   User       @relation(fields: [changedById], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
}

model LeadActivity {
  id          String           @id @default(cuid())
  leadId      String
  userId      String?
  type        LeadActivityType
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime         @default(now())

  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([type])
  @@index([createdAt])
}

model LeadFollowUp {
  id           String         @id @default(cuid())
  leadId       String
  counsellorId String
  createdById  String
  type         FollowUpType   @default(CALL)
  status       FollowUpStatus @default(PENDING)
  scheduledAt  DateTime
  completedAt  DateTime?
  notes        String?
  outcome      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  lead         Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  counsellor   User           @relation("FollowUpCounsellor", fields: [counsellorId], references: [id], onDelete: Cascade)
  createdBy    User           @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([counsellorId])
  @@index([status])
  @@index([scheduledAt])
}

model AIConversation {
  id           String      @id @default(cuid())
  instituteId  String
  userId       String
  title        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  messages     AIMessage[]

  institute    Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, instituteId])
  @@index([updatedAt])
}

model AIMessage {
  id              String         @id @default(cuid())
  conversationId  String
  role            String         // "user" | "assistant" | "system" | "tool"
  content         String
  toolName        String?
  toolCallId      String?
  toolArgs        Json?
  toolResult      Json?
  createdAt       DateTime       @default(now())

  conversation    AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ─── Per-User Module Permissions (for CENTER_MANAGER granular access) ────────

model UserPermission {
  id           String   @id @default(cuid())
  userId       String
  permissionId String
  grantedAt    DateTime @default(now())
  grantedById  String?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("PermissionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, permissionId])
  @@index([userId])
}

// ─── Master Module / Master Data Management ──────────────────────────────────

model MasterRecord {
  id          String    @id @default(cuid())
  instituteId String
  branchId    String?
  entityType  String    // e.g. "classroom", "leadsource", "leadstage", "feehead", etc.
  code        String?
  name        String
  description String?
  status      Status    @default(ACTIVE)
  sortOrder   Int       @default(0)
  data        Json?     // Custom entity-specific key-values (capacity, color, slaHours, etc.)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // Reverse relations for master FK references
  leadsAsSource              Lead[]         @relation("LeadSourceMaster")
  leadsAsStage               Lead[]         @relation("LeadStageMaster")
  leadsAsType                Lead[]         @relation("LeadTypeMaster")
  enquiriesAsSource          Enquiry[]      @relation("EnquirySourceMaster")
  studentsAsQualification    Student[]      @relation("StudentQualificationMaster")
  studentsAsArea             Student[]      @relation("StudentAreaMaster")
  facultyAsDesignation       Faculty[]      @relation("FacultyDesignationMaster")
  facultyAsQualification     Faculty[]      @relation("FacultyQualificationMaster")
  classSessionsAsClassroom   ClassSession[] @relation("ClassSessionClassroomMaster")
  classSessionsAsTimeslot    ClassSession[] @relation("ClassSessionTimeslotMaster")
  batchesAsClassroom         Batch[]        @relation("BatchClassroomMaster")
  batchesAsTimeslot          Batch[]        @relation("BatchTimeslotMaster")
  paymentsAsMode             Payment[]      @relation("PaymentModeMaster")
  paymentsAsBankAccount      Payment[]      @relation("PaymentBankAccountMaster")
  paymentsAsFeeHead          Payment[]      @relation("PaymentFeeHeadMaster")
  pendingFeesAsFeeHead       PendingFee[]   @relation("PendingFeeHeadMaster")
  admissionsAsStatus         Admission[]    @relation("AdmissionStatusMaster")
  admissionsAsConcession     Admission[]    @relation("AdmissionConcessionMaster")
  assignmentsAsType          Assignment[]   @relation("AssignmentTypeMaster")
  examsAsTerm                Exam[]         @relation("ExamTermMaster")
  userSettingsAsDesignation  UserSettings[] @relation("UserSettingsDesignationMaster")

  @@unique([instituteId, entityType, name])
  @@index([instituteId, entityType])
  @@index([branchId, entityType])
  @@index([entityType, status])
  @@index([createdAt])
}

// ─── Internal Team Chat ──────────────────────────────────────────────────────

enum ConversationType {
  TEAM
  DIRECT
}

model Conversation {
  id          String           @id @default(cuid())
  instituteId String
  branchId    String?
  type        ConversationType @default(DIRECT)
  title       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  institute   Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch      Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)

  members     ConversationMember[]
  messages    Message[]

  @@index([instituteId])
  @@index([branchId])
  @@index([type])
  @@index([updatedAt])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ─── Target & Incentive Management System ───────────────────────────────────

enum TargetPeriod {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum TargetStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  LOCKED
  CANCELLED
}

enum TargetMetric {
  LEADS_CREATED
  LEADS_CONTACTED
  FOLLOW_UPS
  QUALIFIED_LEADS
  COUNSELLING_SESSIONS
  DEMO_SESSIONS
  ADMISSIONS
  CONVERTED_LEADS
  ADMISSION_REVENUE
  FEE_COLLECTION
}

enum TargetType {
  INDIVIDUAL
  BRANCH
}

enum IncentiveType {
  FIXED
  SLAB
  PERCENTAGE
}

enum IncentiveStatus {
  CALCULATED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAYROLL_PROCESSED
  PAID
  CANCELLED
}

model TargetPlan {
  id          String       @id @default(cuid())
  instituteId String
  branchId    String?
  name        String
  description String?
  periodType  TargetPeriod @default(MONTHLY)
  startDate   DateTime
  endDate     DateTime
  status      TargetStatus @default(DRAFT)
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy User      @relation("TargetPlanCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  targets    Target[]
  incentives Incentive[]

  @@index([instituteId])
  @@index([branchId])
  @@index([status])
  @@index([startDate, endDate])
}

model Target {
  id           String       @id @default(cuid())
  instituteId  String
  branchId     String?
  targetPlanId String?
  userId       String?      // Nullable for branch targets, populated for individual counselor targets
  title        String
  targetType   TargetType   @default(INDIVIDUAL)
  metric       TargetMetric
  targetValue  Decimal      @default(0) @db.Decimal(14, 2)
  unit         String       @default("COUNT") // COUNT, INR, SESSIONS
  startDate    DateTime
  endDate      DateTime
  status       TargetStatus @default(ACTIVE)
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  institute  Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  targetPlan TargetPlan? @relation(fields: [targetPlanId], references: [id], onDelete: SetNull)
  user       User?       @relation("TargetAssignedTo", fields: [userId], references: [id], onDelete: SetNull)
  createdBy  User        @relation("TargetCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  incentiveRule  IncentiveRule?
  targetProgress TargetProgress[]
  incentives     Incentive[]

  @@index([instituteId])
  @@index([branchId])
  @@index([targetPlanId])
  @@index([userId])
  @@index([metric])
  @@index([status])
  @@index([startDate, endDate])
}

model IncentiveRule {
  id            String        @id @default(cuid())
  targetId      String        @unique
  incentiveType IncentiveType @default(SLAB)
  fixedAmount   Decimal?      @db.Decimal(12, 2)
  slabs         Json?         // [{ minPercent: 50, maxPercent: 74, amount: 2000 }, ...]
  percentages   Json?         // [{ minPercent: 100, maxPercent: 109, ratePercent: 1.0 }, ...]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId])
}

model TargetProgress {
  id                    String   @id @default(cuid())
  targetId              String
  userId                String?
  targetValue           Decimal  @db.Decimal(14, 2)
  achievedValue         Decimal  @db.Decimal(14, 2)
  achievementPercentage Decimal  @db.Decimal(8, 2)
  remainingValue        Decimal  @db.Decimal(14, 2)
  potentialIncentive    Decimal  @default(0) @db.Decimal(12, 2)
  calculatedAt          DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([targetId])
  @@index([userId])
  @@index([calculatedAt])
}

model Incentive {
  id                    String          @id @default(cuid())
  instituteId           String
  branchId              String?
  targetId              String
  targetPlanId          String?
  userId                String          // Counselor who earned the incentive
  periodStart           DateTime
  periodEnd             DateTime
  targetValue           Decimal         @db.Decimal(14, 2)
  achievedValue         Decimal         @db.Decimal(14, 2)
  achievementPercentage Decimal         @db.Decimal(8, 2)
  calculatedAmount      Decimal         @db.Decimal(12, 2)
  approvedAmount        Decimal?        @db.Decimal(12, 2)
  status                IncentiveStatus @default(CALCULATED)
  approvedById          String?
  approvedAt            DateTime?
  rejectionReason       String?
  adjustmentNotes       String?
  paidAt                DateTime?
  payrollRef            String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  institute  Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  target     Target      @relation(fields: [targetId], references: [id], onDelete: Cascade)
  targetPlan TargetPlan? @relation(fields: [targetPlanId], references: [id], onDelete: SetNull)
  user       User        @relation("IncentiveUser", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User?       @relation("IncentiveApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([instituteId])
  @@index([branchId])
  @@index([targetId])
  @@index([targetPlanId])
  @@index([userId])
  @@index([status])
  @@index([periodStart, periodEnd])
}

// ─── Examination Management System ───────────────────────────────────────────

enum ExamStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  LIVE
  ENDED
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum ExamType {
  ONLINE
  OFFLINE
}

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTIPLE
  TRUE_FALSE
  SHORT_ANSWER
  LONG_ANSWER
  NUMERICAL
  FILL_BLANK
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  ACTIVE
  INACTIVE
}

model QuestionBank {
  id          String        @id @default(cuid())
  instituteId String
  branchId    String?
  name        String
  description String?
  courseId    String?
  status      QuestionStatus @default(ACTIVE)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  institute   Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch      Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  course      Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy   User          @relation("QuestionBankCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  questions   Question[]

  @@unique([instituteId, name])
  @@index([instituteId])
  @@index([branchId])
  @@index([courseId])
  @@index([status])
}

model Question {
  id             String         @id @default(cuid())
  instituteId    String
  branchId       String?
  questionBankId String?
  courseId       String?
  moduleId       String?
  questionType   QuestionType
  questionText   String         @db.Text
  difficulty     DifficultyLevel @default(MEDIUM)
  marks          Float          @default(1)
  negativeMarks  Float          @default(0)
  explanation    String?        @db.Text
  status         QuestionStatus @default(ACTIVE)
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  institute    Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  questionBank QuestionBank? @relation(fields: [questionBankId], references: [id], onDelete: SetNull)
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  module       CourseModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  createdBy    User          @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  options      QuestionOption[]
  examQuestions ExamQuestion[]
  examAnswers   ExamAnswer[]

  @@index([instituteId])
  @@index([branchId])
  @@index([questionBankId])
  @@index([courseId])
  @@index([moduleId])
  @@index([questionType])
  @@index([difficulty])
  @@index([status])
}

model QuestionOption {
  id           String   @id @default(cuid())
  questionId   String
  optionText   String
  isCorrect    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Exam {
  id                   String     @id @default(cuid())
  instituteId          String
  branchId             String?
  name                 String
  description          String?    @db.Text
  instructions         String?    @db.Text
  courseId             String?
  moduleId             String?
  examTermMasterId     String?
  createdById          String
  durationMinutes      Int        @default(60)
  totalMarks           Float      @default(0)
  passingMarks         Float      @default(0)
  attemptsAllowed      Int        @default(1)
  status               ExamStatus @default(DRAFT)
  examType             ExamType   @default(ONLINE)
  startAt              DateTime?
  endAt                DateTime?
  negativeMarkingEnabled Boolean  @default(false)
  showResults          Boolean    @default(true)
  randomizeQuestions   Boolean    @default(false)
  randomizeOptions     Boolean    @default(false)
  // Proctoring config
  proctoringEnabled          Boolean    @default(false)
  fullscreenRequired         Boolean    @default(true)
  maxWarnings                Int        @default(3)
  tabSwitchDetection         Boolean    @default(true)
  windowBlurDetection        Boolean    @default(true)
  fullscreenExitDetection    Boolean    @default(true)
  keyboardShortcutDetection  Boolean    @default(true)
  copyPasteDetection         Boolean    @default(true)
  rightClickDetection        Boolean    @default(false)
  networkGracePeriodSeconds  Int        @default(30)
  autoTerminateOnMaxViolations Boolean  @default(true)
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt

  institute  Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch     Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  course     Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  module     CourseModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  createdBy  User          @relation("ExamCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  examTermMaster MasterRecord? @relation("ExamTermMaster", fields: [examTermMasterId], references: [id], onDelete: SetNull)

  examQuestions    ExamQuestion[]
  batchAssignments ExamBatch[]
  studentAssignments ExamStudent[]
  attempts         ExamAttempt[]

  @@index([instituteId])
  @@index([branchId])
  @@index([courseId])
  @@index([moduleId])
  @@index([status])
  @@index([examType])
  @@index([createdById])
  @@index([startAt])
  @@index([instituteId, status])
}

model ExamQuestion {
  id           String   @id @default(cuid())
  examId       String
  questionId   String
  displayOrder Int      @default(0)
  marksOverride Float?  // Override question's default marks for this exam
  createdAt    DateTime @default(now())

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
  @@index([examId])
  @@index([questionId])
}

model ExamBatch {
  id        String   @id @default(cuid())
  examId    String
  batchId   String
  assignedAt DateTime @default(now())

  exam  Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([examId, batchId])
  @@index([examId])
  @@index([batchId])
}

model ExamStudent {
  id         String   @id @default(cuid())
  examId     String
  studentId  String
  assignedAt DateTime @default(now())

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EVALUATING
  COMPLETED
  TERMINATED
  EXPIRED
}

enum ProctoringEventType {
  TAB_SWITCH
  WINDOW_BLUR
  VISIBILITY_HIDDEN
  FULLSCREEN_EXIT
  KEYBOARD_SHORTCUT
  COPY_ATTEMPT
  PASTE_ATTEMPT
  RIGHT_CLICK
  DEVTOOLS_ATTEMPT
  NETWORK_DISCONNECT
  SESSION_CONFLICT
  SUSPICIOUS_BROWSER_EVENT
}

model ExamAttempt {
  id                   String        @id @default(cuid())
  instituteId          String
  branchId             String?
  examId               String
  studentId            String
  userId               String
  status               AttemptStatus @default(NOT_STARTED)
  attemptNumber        Int           @default(1)
  startedAt            DateTime?
  expiresAt            DateTime?     // Server-authoritative timer deadline
  submittedAt          DateTime?
  terminatedAt         DateTime?
  terminationReason    String?
  proctoringEnabled    Boolean       @default(true)
  violationCount       Int           @default(0)
  warningCount         Int           @default(0)
  maxViolations        Int           @default(3)
  lastProctoringEventAt DateTime?
  score                Float?
  totalMarks           Float?
  percentage           Float?
  passed               Boolean?
  feedback             String?       @db.Text
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  institute   Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch      Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  exam        Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  answers          ExamAnswer[]
  proctoringEvents ExamProctoringEvent[]

  @@unique([examId, studentId, attemptNumber])
  @@index([instituteId])
  @@index([branchId])
  @@index([examId])
  @@index([studentId])
  @@index([userId])
  @@index([status])
  @@index([startedAt])
}

model ExamAnswer {
  id                 String   @id @default(cuid())
  attemptId          String
  questionId         String
  selectedOptionIds  Json?    // String array of option IDs
  textAnswer         String?  @db.Text
  numericalAnswer    Float?
  isCorrect          Boolean?
  marksAwarded       Float?   @default(0)
  isFlagged          Boolean  @default(false)
  savedAt            DateTime @default(now())
  updatedAt          DateTime @updatedAt

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model ExamProctoringEvent {
  id                 String              @id @default(cuid())
  attemptId          String
  instituteId        String
  eventType          ProctoringEventType
  clientEventId      String?             // For client-side idempotency
  occurredAt         DateTime            // When browser detected it
  receivedAt         DateTime            @default(now()) // When server received it
  metadata           Json?               // Safe diagnostic payload
  sequenceNumber     Int                 @default(1)
  isCountedViolation Boolean             @default(true) // False if suppressed by debounce
  warningNumber      Int?
  createdAt          DateTime            @default(now())

  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  institute Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([attemptId, clientEventId])
  @@index([attemptId])
  @@index([instituteId])
  @@index([eventType])
  @@index([occurredAt])
}

// ─── ERP Restructure: Documents, Fees, Placement, Email, Billing ─────────────

enum DocumentEntity {
  STUDENT
  ADMISSION
  LEAD
}

enum DocumentStatus {
  PENDING
  UPLOADED
  VERIFIED
  REJECTED
}

enum PlacementApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  SELECTED
  REJECTED
  WITHDRAWN
}

enum PlacementInterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PlacementRecordStatus {
  OFFERED
  JOINED
  DECLINED
}

enum EmailTemplateStatus {
  ACTIVE
  INACTIVE
}

enum EmailLogStatus {
  PENDING
  SENT
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Document {
  id             String         @id @default(cuid())
  instituteId    String
  branchId       String?
  entityType     DocumentEntity
  entityId       String
  name           String
  fileName       String
  fileUrl        String?
  mimeType       String?
  fileSize       Int?
  status         DocumentStatus @default(PENDING)
  uploadedById   String?
  verifiedById   String?
  verifiedAt     DateTime?
  rejectedReason String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  institute  Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch     Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  uploadedBy User?     @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  verifiedBy User?     @relation("DocumentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([instituteId])
  @@index([branchId])
  @@index([entityType, entityId])
  @@index([status])
}

model FeePlanTemplate {
  id           String   @id @default(cuid())
  instituteId  String
  branchId     String?
  courseId     String?
  name         String
  code         String?
  totalAmount  Float
  planType     FeePlan  @default(FULL_PAYMENT)
  installments Json?
  description  String?
  status       Status   @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  course    Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([instituteId])
  @@index([branchId])
  @@index([courseId])
  @@index([status])
}

model PlacementCompany {
  id            String   @id @default(cuid())
  instituteId   String
  name          String
  industry      String?
  website       String?
  contactPerson String?
  contactEmail  String?
  contactPhone  String?
  address       String?
  status        Status   @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institute Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  jobs      PlacementJob[]
  records   PlacementRecord[]

  @@index([instituteId])
  @@index([status])
}

model PlacementJob {
  id          String    @id @default(cuid())
  instituteId String
  companyId   String
  title       String
  description String?   @db.Text
  location    String?
  salaryRange String?
  openings    Int       @default(1)
  eligibility Json?
  deadline    DateTime?
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  institute    Institute              @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  company      PlacementCompany       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications PlacementApplication[]
  records      PlacementRecord[]

  @@index([instituteId])
  @@index([companyId])
  @@index([status])
}

model PlacementApplication {
  id          String                     @id @default(cuid())
  instituteId String
  branchId    String?
  jobId       String
  studentId   String
  status      PlacementApplicationStatus @default(APPLIED)
  appliedAt   DateTime                   @default(now())
  notes       String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  institute  Institute              @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch     Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  job        PlacementJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student    Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  interviews PlacementInterview[]

  @@unique([jobId, studentId])
  @@index([instituteId])
  @@index([branchId])
  @@index([jobId])
  @@index([studentId])
  @@index([status])
}

model PlacementInterview {
  id            String                   @id @default(cuid())
  applicationId String
  scheduledAt   DateTime
  mode          String?
  location      String?
  interviewer   String?
  status        PlacementInterviewStatus @default(SCHEDULED)
  feedback      String?                  @db.Text
  rating        Int?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  application PlacementApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([scheduledAt])
  @@index([status])
}

model PlacementRecord {
  id            String                @id @default(cuid())
  instituteId   String
  branchId      String?
  studentId     String
  companyId     String
  jobId         String?
  applicationId String?
  package       String?
  joiningDate   DateTime?
  status        PlacementRecordStatus @default(OFFERED)
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  institute Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  company   PlacementCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job       PlacementJob?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([instituteId])
  @@index([branchId])
  @@index([studentId])
  @@index([companyId])
  @@index([status])
}

model EmailTemplate {
  id          String              @id @default(cuid())
  instituteId String
  name        String
  subject     String
  body        String              @db.Text
  variables   Json?
  status      EmailTemplateStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  institute Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  logs      EmailLog[]

  @@unique([instituteId, name])
  @@index([instituteId])
  @@index([status])
}

model EmailLog {
  id          String         @id @default(cuid())
  instituteId String
  templateId  String?
  toEmail     String
  subject     String
  body        String?        @db.Text
  status      EmailLogStatus @default(PENDING)
  error       String?
  sentById    String?
  sentAt      DateTime?
  createdAt   DateTime       @default(now())

  institute Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  template  EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sentBy    User?          @relation("EmailLogSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([instituteId])
  @@index([templateId])
  @@index([status])
  @@index([createdAt])
}

model BillingPlan {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  price        Float
  billingCycle String   @default("MONTHLY")
  features     Json?
  status       Status   @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]

  @@index([status])
}

model Subscription {
  id            String             @id @default(cuid())
  instituteId   String
  billingPlanId String
  status        SubscriptionStatus @default(ACTIVE)
  startDate     DateTime           @default(now())
  endDate       DateTime?
  autoRenew     Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  institute   Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  billingPlan BillingPlan @relation(fields: [billingPlanId], references: [id], onDelete: Restrict)
  invoices    Invoice[]

  @@index([instituteId])
  @@index([billingPlanId])
  @@index([status])
}

model Invoice {
  id             String        @id @default(cuid())
  instituteId    String
  subscriptionId String?
  invoiceNo      String        @unique
  amount         Float
  taxAmount      Float         @default(0)
  totalAmount    Float
  status         InvoiceStatus @default(DRAFT)
  dueDate        DateTime
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  institute    Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([instituteId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
}

