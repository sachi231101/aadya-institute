# =============================================
# Aadya Institute — Backend Environment Config
# =============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Server
PORT=5000
NODE_ENV=development

# Browser CORS — comma-separated frontend origins
# Dev: localhost + private LAN origins are allowed; add ngrok HTTPS origin when tunneling
# Production: REQUIRED — e.g. https://app.yourdomain.com
# See docs/local-network-access.md for LAN + ngrok setup
CORS_ORIGIN=http://localhost:5173

# Public frontend URL used in invitation emails (no trailing slash)
# When using ngrok, set this to the ngrok HTTPS URL
FRONTEND_URL=http://localhost:5173

# Process roles
# API process on Hostinger: RUN_WORKERS=false
# Worker process: RUN_WORKERS=true
# Local `npm run dev` defaults RUN_WORKERS=true when unset (non-production)
RUN_WORKERS=true
# Set true during large live exams to throttle low-priority queues
PEAK_MODE=false

# PostgreSQL — include pool sizing in production, e.g. ?connection_limit=15&pool_timeout=20
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/aadya_institute"
PRISMA_CONNECTION_LIMIT=15

# Redis
REDIS_URL="redis://localhost:6379"

# JWT — Access Token
# Use a long random string (min 32 chars) — e.g. openssl rand -hex 32
JWT_ACCESS_SECRET=change-this-to-a-secure-random-string
JWT_ACCESS_EXPIRES_IN=1d

# JWT — Refresh Token
# Must be DIFFERENT from JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=change-this-to-a-different-secure-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Seeding
# Password used when creating the initial admin user via `npm run prisma:seed`
SEED_ADMIN_PASSWORD=ChangeMe@123

# ─── MSG91 WhatsApp ───────────────────────────────────────────────────────────
# Obtain Auth Key from: MSG91 Panel → Authkey
# Integrated number = WhatsApp Business number connected in MSG91 (with country code)
MSG91_AUTH_KEY=494380AxcZxMzcL699188a5P1
MSG91_WHATSAPP_NUMBER=918431310747
MSG91_API_BASE_URL=https://api.msg91.com
MSG91_CONTROL_BASE_URL=https://control.msg91.com

# ─── Webhook Security ─────────────────────────────────────────────────────────
# Shared secret for verifying WhatsApp delivery webhooks (x-webhook-token / ?token=)
WHATSAPP_WEBHOOK_SECRET=

# ─── WhatsApp Queue ───────────────────────────────────────────────────────────
WHATSAPP_MAX_RETRIES=3
WHATSAPP_QUEUE_CONCURRENCY=5

# ─── AI Data Agent / LLM Provider ─────────────────────────────────────────────
# OpenAI / NVIDIA NIM / DeepSeek / Local compatible endpoint
LLM_API_KEY=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
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# ─── Google Workspace & Google Meet ──────────────────────────────────────────
# Obtain OAuth Credentials from Google Cloud Console (APIs & Services → Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/integrations/google/callback
GOOGLE_PROJECT_ID=your-google-cloud-project-id
GOOGLE_MEET_SCOPES="https://www.googleapis.com/auth/meetings.space.created https://www.googleapis.com/auth/meetings.space.readonly"
GOOGLE_DRIVE_SCOPES="https://www.googleapis.com/auth/drive"
GOOGLE_TOKEN_ENCRYPTION_KEY=your-32-char-encryption-key-for-oauth-tokens
INTEGRATION_ENCRYPTION_KEY=your-32-char-encryption-key-for-integration-secrets
# Default class-recording retention; Integration.configuration.recordingRetentionDays overrides per institute.
RECORDING_RETENTION_DAYS=7

# ─── Telephony / AI Calling (dial-only) ───────────────────────────────────────
# Voice Agent create / commit / deploy: do this in the Sarvam dashboard, not in Aadya.
# Aadya only triggers outbound calls to an already-deployed agent.
#
# Instant Outbound base (NOT https://api.sarvam.ai — that is STT/TTS):
TELEPHONY_BASE_URL=https://apps.sarvam.ai/api/outbounds
TELEPHONY_API_KEY=
# Optional fallback if TELEPHONY_API_KEY is unset (same key used for dialing):
# IMPORTANT: Voice Agents Instant Outbound needs the key from
# Sarvam Voice Agents dashboard → Settings → API Key (X-API-Key).
# An api.sarvam.ai "sk_…" subscription key is for STT/TTS and will return
# "Invalid API key format" on Instant Outbound.
SARVAM_API_KEY=
# Optional STT/TTS base (not used for dialing):
# SARVAM_API_BASE_URL=https://api.sarvam.ai
# Caller ID must match the number deployed on the Sarvam agent:
TELEPHONY_FROM_NUMBER=+918064270268
# Public base URL used for Sarvam call result webhooks:
# Local: http://localhost:5000 — or your ngrok HTTPS URL (see docs/local-network-access.md)
PUBLIC_API_BASE_URL=http://localhost:5000
# Sarvam Voice Agents scope (from dashboard URL / Settings / Phone connection):
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
# Optional webhook shared secret (platform or env):
# AI_CALLING_WEBHOOK_SECRET=
# SARVAM_WEBHOOK_SECRET=
#
# In Admin → Integrations → AI Calling: turn "AI Calling enabled" ON and set From number
# (or rely on TELEPHONY_FROM_NUMBER). Do not paste API keys into the institute form for testing.
